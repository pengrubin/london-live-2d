# Scratch space (review agents and one-off experiments write here).
tmp/
node_modules/
dist/
.env
.env.*
!.env.example
.DS_Store
*.log

# Large basemap binaries, one per region — regenerate with:
#   pmtiles extract https://build.protomaps.com/<build>.pmtiles data/<region>.pmtiles --bbox=<minLon,minLat,maxLon,maxLat>
# London: --bbox=-0.55,51.25,0.35,51.72
data/**/*.pmtiles
data/*.pmtiles

# Runtime-written state and upstream caches, at any region depth — a second
# region writes its own under data/<region>/, which single-level globs miss.
data/**/bus-traces/
data/**/osm-cache/
data/**/bus-routes/
data/**/bus-rollups/
data/**/tube-status/
data/**/road-disruptions/
data/**/diversions/
data/**/coverage/
data/**/leaderboard.json
data/**/leaderboard.json.tmp
data/bus-traces/
data/osm-cache/
data/bus-routes/
data/bus-rollups/
data/tube-status/
data/road-disruptions/
data/diversions/
data/coverage/
data/leaderboard.json
data/leaderboard.json.tmp
