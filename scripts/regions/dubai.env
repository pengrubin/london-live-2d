# Deployment settings for the Dubai region — the same values a Railway service
# would carry. Separate from dubai.mjs, which describes only what to BAKE.
# Credentials are never listed here; scripts/dev-region.sh carries over the
# global ones (AIS) from backend/.env.
REGION_NAME=Dubai
REGION_BBOX=54.85,24.75,55.65,25.45
REGION_VIEW_BOUNDS=54.7,24.6,55.8,25.6
REGION_CENTER=55.27,25.2
REGION_ZOOM=11
ADSB_CENTER=55.36,25.25
ADSB_RADIUS_NM=45
AIS_BBOX=54.5,24.4,55.9,25.9
# Environment Agency gauges are English stations only.
TIDE_GAUGES=off

# Careem Bike — an open GBFS 3.0 feed, no key required.
GBFS_URL=https://careem.publicbikesystem.net/customer/gbfs/v3.0/gbfs.json
