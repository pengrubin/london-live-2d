# ── credentials ──────────────────────────────────────────────────────────────
# Every feed is OPTIONAL and independently gated: a key that is absent means
# that layer is absent, not that the server fails to start. GET /api/capabilities
# reports which layers a running deployment actually has.

# TfL API portal (api-portal.tfl.gov.uk): subscribe to the "500 Requests per min"
# product, then copy the Primary key from Profile → Subscriptions.
# Unset → no tube/DLR/Overground/Elizabeth line, arrivals, line status, jam cams,
# road disruptions or cycle-hire docks. Required for a London deployment.
TFL_APP_KEY=your-primary-key-here

# DfT Bus Open Data Service — live bus positions. Unset → no bus layer.
# BODS_API_KEY=

# National Rail Darwin OpenLDBWS — departure boards. Unset → no NR layer.
# DARWIN_TOKEN=

# GBFS discovery document (gbfs.json) for docked bike share — an OPEN STANDARD
# used by several hundred systems worldwide, so this is not city-specific.
# Unset → no bike layer. Example (Dubai's Careem Bike, no key needed):
#   GBFS_URL=https://careem.publicbikesystem.net/customer/gbfs/v3.0/gbfs.json
# GBFS_URL=

# aisstream.io — live vessel positions. Unset → no ship layer.
# Works anywhere in the world; see AIS_BBOX below for the area subscribed to.
# AIS_API_KEY=

PORT=3000

# Directory for runtime-mutable state (leaderboard standings + learner marker).
# Leave UNSET locally: state stays under data/ exactly as it does today.
# In production (Railway), mount a Volume and point this at it so standings and
# the learner schedule survive redeploys — recommended: mount at /data and set
#   PERSIST_DIR=/data
# Only runtime-written state moves here; git-committed baked data (branches,
# lines, stations, nr, manifest) is still read from data/.
# PERSIST_DIR=/data

# ── region ───────────────────────────────────────────────────────────────────
# The geography this deployment serves. EVERY variable below defaults to the
# London values the code used before they were configurable, so an existing
# deployment that sets none of them is completely unaffected.
#
# COORDINATE ORDER IS lon,lat THROUGHOUT (GeoJSON order) — including the boxes,
# which are "minLon,minLat,maxLon,maxLat". Upstreams that want lat first
# (aisstream, adsb.lol) are converted internally.
#
# A malformed value stops the server at startup with a message naming the
# variable. That is deliberate: a silently wrong box yields an empty map, which
# is far harder to diagnose than a refusal to boot.

# Display name only — never used to switch behaviour.
# REGION_NAME=London

# Canonical data box: the bus-feed query, the tide-gauge filter, and the bounds
# used to validate caller-supplied coordinates (widened by 0.2°).
# REGION_BBOX=-0.55,51.25,0.35,51.72

# Map pan limit — deliberately wider than REGION_BBOX so panning never hits a
# hard wall at the edge of the data.
# REGION_VIEW_BOUNDS=-0.65,51.2,0.45,51.77

# Initial map view.
# REGION_CENTER=-0.1276,51.5072
# REGION_ZOOM=11

# Vessel subscription box. Separate from REGION_BBOX because ships are worth
# showing further offshore than the land area the other feeds cover.
# AIS_BBOX=-0.55,51.3,0.45,51.62

# Aircraft are queried as a circle, not a box: both ADS-B networks take a centre
# point plus a radius in nautical miles.
# ADSB_CENTER=-0.12,51.5
# ADSB_RADIUS_NM=30

# Tide gauges come from the Environment Agency, which publishes English stations
# only. Set to "off" outside the UK so no pointless upstream call is made.
# TIDE_GAUGES=on

# Basemap extract for this region, reported to the frontend so one bundle serves
# every deployment. Unset leaves the frontend on its build-time default
# (VITE_PMTILES_URL, then /london.pmtiles). Build one with:
#   pmtiles extract https://build.protomaps.com/<YYYYMMDD>.pmtiles out.pmtiles \
#     --bbox=<minLon,minLat,maxLon,maxLat>
# REGION_PMTILES_URL=https://<your-r2-bucket>/<region>.pmtiles
